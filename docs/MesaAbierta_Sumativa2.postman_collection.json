{
  "info": {
    "name": "Mesa Abierta - Sumativa 2 JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Importar en Postman. Ejecutar login primero para guardar token."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/recetas"
    },
    {
      "key": "jwt",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Login JWT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"chefana\", \"password\": \"Recetas2026!\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if(data.accessToken){ pm.collectionVariables.set(\"jwt\", data.accessToken); }"
            ]
          }
        }
      ]
    },
    {
      "name": "2 - Listar recetas públicas",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/recetas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "recetas"
          ]
        }
      }
    },
    {
      "name": "3 - Ver receta privada (JWT)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/recetas/pasta-pesto",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "recetas",
            "pasta-pesto"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwt}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "4 - Comentar (JWT)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/recetas/pasta-pesto/comentarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "recetas",
            "pasta-pesto",
            "comentarios"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwt}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"texto\": \"Comentario de demostración API\"}"
        }
      }
    },
    {
      "name": "5 - Puntuar (JWT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/recetas/pasta-pesto/valoracion",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "recetas",
            "pasta-pesto",
            "valoracion"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwt}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"puntuacion\": 5}"
        }
      }
    },
    {
      "name": "6 - Compartir en sitio (JWT)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/recetas/pasta-pesto/compartir",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "recetas",
            "pasta-pesto",
            "compartir"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwt}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"plataforma\": \"SITIO\"}"
        }
      }
    },
    {
      "name": "7 - Publicar receta (JWT)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/recetas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "recetas"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwt}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\": \"Cazuela de verduras\", \"cocina\": \"Chilena\", \"pais\": \"Chile\", \"dificultad\": \"Fácil\", \"minutos\": 45, \"porciones\": 4, \"resumen\": \"Preparación casera\", \"introduccion\": \"Receta para compartir\", \"ingredientes\": \"Papa\\nZapallo\", \"pasos\": \"Pelar\\nHervir\"}"
        }
      }
    }
  ]
}